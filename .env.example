# Copy to .env and edit. Environment variables override config.yaml.

APP_NAME="Agent Workflow Metadata API"
APP_VERSION="0.1.0"
ENV=dev
LOG_LEVEL=INFO

HOST=127.0.0.1
PORT=8000

# JSON-encoded list. Origins for the React Workflow Builder dev server.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional: path to a YAML config file. Defaults to ./config.yaml if present.
# CONFIG_FILE=config.yaml

# --- MongoDB ---
# Connection string. For Atlas use mongodb+srv://...
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=agent_workflows
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Set to true to skip mongo startup (e.g. running tests without a DB).
MONGODB_SKIP_STARTUP=false
